{
    "name": "slimory",
    "version": "0.4.0",
    "author": "Slimory",
    "description": "An open-source, free AI desktop assistant for Windows that works in any application.",
    "main": "dist-electron/main/main.js",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "preview": "vite preview",
        "build": "tsc && vite build && npm run copy-prompts && npm run copy-webpilot-scripts && npm run copy-worklet && npm run copy-i18n && npx electron-builder --win",
        "dev-build": "tsc && vite build && npm run copy-prompts && npm run copy-webpilot-scripts && npm run copy-worklet && npm run copy-i18n",
        "dev-build-test": "tsc && vite build --config vite.test.config.ts && npm run copy-prompts && npm run copy-webpilot-scripts",
        "electron:dev": "npm run dev-build && concurrently \"vite\" \"wait-on tcp:127.0.0.1:5174 && electron .\"",
        "copy-prompts": "node scripts/copy-prompts.js",
        "copy-webpilot-scripts": "node scripts/copy-webpilot-scripts.js",
        "copy-worklet": "node scripts/copy-worklet.js",
        "copy-i18n": "node scripts/copy-i18n.js",
        "test:websearch": "tsc -p tsconfig.main.json && chcp 65001 && electron dist-electron/scripts/tests/testWebSearch.js",
        "test:operationgenerator": "vite build --config vite.test.config.ts && chcp 65001 && electron dist-electron/scripts/tests/testOperationGenerator.js"
    },
    "keywords": [
        "electron",
        "desktop-app",
        "desktop-application",
        "windows",
        "ai-assistant",
        "ai",
        "artificial-intelligence",
        "text-selection",
        "browser-automation",
        "web-automation",
        "automation",
        "productivity",
        "assistant",
        "open-source",
        "privacy",
        "local-storage",
        "translation",
        "chat",
        "llm"
    ],
    "license": "MIT",
    "devDependencies": {
        "@types/katex": "0.16.7",
        "@types/node": "^20.10.0",
        "@types/react": "^18.2.45",
        "@types/react-dom": "^18.2.18",
        "@vitejs/plugin-react": "^4.2.1",
        "concurrently": "^8.2.2",
        "cross-env": "10.1.0",
        "electron": "39.2.6",
        "electron-builder": "^24.9.1",
        "electron-rebuild": "3.2.9",
        "node-abi": "4.17.0",
        "opencc-js": "1.0.5",
        "tsx": "4.20.6",
        "typescript": "^5.3.3",
        "vite": "^5.0.8",
        "vite-plugin-electron": "^0.28.2",
        "vite-plugin-electron-renderer": "^0.14.5",
        "wait-on": "^7.2.0"
    },
    "dependencies": {
        "@earendil-works/pi-ai": "0.74.2",
        "electron-build": "0.0.3",
        "i18next": "25.6.0",
        "i18next-browser-languagedetector": "8.2.0",
        "katex": "0.16.27",
        "koffi": "2.14.1",
        "lucide-react": "0.577.0",
        "node-wav": "0.0.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-i18next": "16.0.1",
        "uiohook-napi": "1.5.4"
    },
    "build": {
        "appId": "com.evita.slimory",
        "productName": "SlimoryLite",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "build/icon.ico"
        ],
        "mac": {
            "target": "dmg",
            "category": "public.app-category.utilities"
        },
        "win": {
            "target": "nsis"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "uninstallDisplayName": "${productName} Uninstaller",
            "deleteAppDataOnUninstall": false
        },
        "extraResources": [
            {
                "from": "resources/GetSelectedText.exe",
                "to": "GetSelectedText.exe"
            },
            {
                "from": "resources/UpdateSelectedText.exe",
                "to": "UpdateSelectedText.exe"
            }
        ]
    }
}
